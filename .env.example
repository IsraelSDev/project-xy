# Copie para .env e ajuste. Nunca versione o .env.
# Não use prefixo VITE_ para nada sensível: variáveis VITE_* vão para o bundle do navegador.

# API (NestJS)
API_PORT=3000

# Realtime (Colyseus)
REALTIME_PORT=2567

# Web (Vite) — porta do dev server
WEB_PORT=5173

# PostgreSQL local (Docker Compose). Troque a senha no seu .env.
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=app
POSTGRES_PORT=5432
