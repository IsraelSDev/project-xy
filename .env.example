# Copie para .env e ajuste. Nunca versione o .env.
# Não use prefixo VITE_ para nada sensível: variáveis VITE_* vão para o bundle do navegador.

# API (NestJS)
API_PORT=3000

# Realtime (Colyseus)
REALTIME_PORT=2567

# Web (Vite) — porta do dev server
WEB_PORT=5173

# Endereço público do realtime visto pelo navegador (não é segredo).
# Vazio = /realtime na mesma origem, que o dev server do Vite repassa para REALTIME_PORT.
# VITE_REALTIME_URL=

# PostgreSQL local (Docker Compose). Troque a senha no seu .env.
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=app
POSTGRES_PORT=5432

# Origens do navegador aceitas pela API em requisições que alteram estado (proteção CSRF).
# Vazio = http://localhost:5173. Várias: separadas por vírgula.
# WEB_ORIGIN=

# Gerados por `pnpm env:setup` (não preencha à mão; nunca versione):
# DATABASE_URL            montada a partir de POSTGRES_*
# REALTIME_TICKET_PRIVATE_KEY  chave Ed25519 da API (assina os tickets do realtime)
# REALTIME_TICKET_PUBLIC_KEY   chave pública correspondente (o realtime só verifica)
# METRICS_TOKEN           Bearer de GET /metrics (API e realtime). Sem ele, /metrics responde 404.
