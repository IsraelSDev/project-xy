{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "types": ["node"],
    // Os pacotes compartilhados (packages/*) importam com extensão .ts (TypeScript nativo do Node).
    "rewriteRelativeImportExtensions": true,
    "noEmit": true
  },
  "include": ["src", "test", "vitest.config.mts", "prisma.config.ts"]
}
