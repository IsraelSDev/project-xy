// Modelo de dados da API. Migrações em prisma/migrations (pnpm --filter @3dx/api db:migrate).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  // A API é ESM (o Nest 12 só existe em ESM); o código gerado é compilado junto pelo nest build.
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  MODERATOR
  ADMIN
}

/// Como a idade foi estabelecida. SELF_DECLARED NÃO é garantia suficiente para lançamento.
enum AgeAssurance {
  SELF_DECLARED
}

enum ReportReason {
  HARASSMENT
  SPAM
  INAPPROPRIATE_CONTENT
  UNDERAGE
  OTHER
}

enum SanctionType {
  /// Sem chat.
  MUTE
  /// Sem login, sem API e sem salas.
  SUSPEND
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

/// Origem da mensagem registrada: chat público da sala ou mensagem privada entre amigos.
enum MessageKind {
  ROOM
  DIRECT
}

enum AppealStatus {
  OPEN
  /// Aceita: a sanção foi revogada.
  ACCEPTED
  REJECTED
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model User {
  id             String       @id @default(uuid()) @db.Uuid
  /// Sempre em minúsculas (normalizado pela API).
  email          String       @unique
  /// scrypt com sal por usuário; nunca a senha.
  passwordHash   String
  displayName    String
  /// displayName em minúsculas: impede nomes iguais que só diferem na caixa.
  displayNameKey String       @unique
  /// null depois da exclusão da conta (anonimizada).
  birthDate      DateTime?    @db.Date
  ageAssurance   AgeAssurance @default(SELF_DECLARED)
  role           Role         @default(USER)
  /// AvatarConfig (catálogo fechado, validado pela API). null = avatar padrão.
  avatar         Json?
  createdAt      DateTime     @default(now())
  /// Conta excluída: dados pessoais apagados; o registro fica para manter denúncias e auditoria.
  deletedAt      DateTime?

  sessions          Session[]
  blocksMade        Block[]            @relation("blocker")
  blocksReceived    Block[]            @relation("blocked")
  reportsMade       Report[]           @relation("reporter")
  reportsReceived   Report[]           @relation("reported")
  moderationActions ModerationAction[] @relation("actor")
  sanctions         Sanction[]         @relation("sanctioned")
  sanctionsIssued   Sanction[]         @relation("issuer")
  appeals           Appeal[]           @relation("appellant")
  appealsReviewed   Appeal[]           @relation("appealReviewer")
  friendshipsA      Friendship[]       @relation("friendA")
  friendshipsB      Friendship[]       @relation("friendB")
}

/// Sessão de login. O id é o SHA-256 do token do cookie: vazar o banco não vaza sessões.
model Session {
  id        String   @id
  userId    String   @db.Uuid
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Block {
  blockerId String   @db.Uuid
  blockedId String   @db.Uuid
  createdAt DateTime @default(now())

  blocker User @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

model Report {
  id         String       @id @default(uuid()) @db.Uuid
  reporterId String       @db.Uuid
  reportedId String       @db.Uuid
  reason     ReportReason
  details    String?
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now())
  reviewedAt DateTime?

  // Restrict: denúncias e o histórico de moderação não somem com a conta.
  reporter  User               @relation("reporter", fields: [reporterId], references: [id], onDelete: Restrict)
  reported  User               @relation("reported", fields: [reportedId], references: [id], onDelete: Restrict)
  actions   ModerationAction[]
  sanctions Sanction[]

  @@index([status, createdAt])
}

/// Sanção da moderação: ao resolver uma denúncia ou direta (flagrante, sem denúncia).
/// Ativa: sem `revokedAt` e com `endsAt` nulo ou futuro.
model Sanction {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @db.Uuid
  type        SanctionType
  /// null = permanente (só suspensão).
  endsAt      DateTime?
  /// null = sanção direta, sem denúncia (aí o motivo é obrigatório).
  reportId    String?      @db.Uuid
  /// Motivo registrado por quem aplicou (visível só para a moderação).
  reason      String?
  createdById String       @db.Uuid
  createdAt   DateTime     @default(now())
  revokedAt   DateTime?

  // Restrict: como as denúncias, o histórico de sanções não some com a conta.
  user      User               @relation("sanctioned", fields: [userId], references: [id], onDelete: Restrict)
  createdBy User               @relation("issuer", fields: [createdById], references: [id], onDelete: Restrict)
  report    Report?            @relation(fields: [reportId], references: [id], onDelete: Restrict)
  actions   ModerationAction[]
  appeal    Appeal?

  @@index([userId, type])
  @@index([createdAt])
}

/// Trilha de auditoria das ações de moderação e administração.
model ModerationAction {
  id         String   @id @default(uuid()) @db.Uuid
  /// null = ação do sistema (ex.: script de linha de comando).
  actorId    String?  @db.Uuid
  reportId   String?  @db.Uuid
  sanctionId String?  @db.Uuid
  action     String
  note       String?
  createdAt  DateTime @default(now())

  actor    User?     @relation("actor", fields: [actorId], references: [id], onDelete: Restrict)
  report   Report?   @relation(fields: [reportId], references: [id], onDelete: Restrict)
  sanction Sanction? @relation(fields: [sanctionId], references: [id], onDelete: Restrict)

  @@index([createdAt])
}

/// Contador de rate limit (janela fixa) compartilhado entre as instâncias da API.
/// Chave: rota + quem (usuário ou IP). Linhas vencidas são apagadas pela própria API.
model RateLimitBucket {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

/// Contestação de uma sanção por quem a recebeu (uma por sanção). Aceitar revoga a sanção.
model Appeal {
  id           String       @id @default(uuid()) @db.Uuid
  sanctionId   String       @unique @db.Uuid
  userId       String       @db.Uuid
  message      String
  status       AppealStatus @default(OPEN)
  /// Resposta da moderação, mostrada à pessoa.
  response     String?
  createdAt    DateTime     @default(now())
  reviewedAt   DateTime?
  reviewedById String?      @db.Uuid

  // Restrict: como denúncias e sanções, o histórico fica.
  sanction   Sanction @relation(fields: [sanctionId], references: [id], onDelete: Restrict)
  user       User     @relation("appellant", fields: [userId], references: [id], onDelete: Restrict)
  reviewedBy User?    @relation("appealReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
}

/// Amizade entre duas contas: uma linha por par, com userAId < userBId (pedido duplicado ou mútuo
/// cai na mesma chave). PENDING: `requesterId` pediu e a outra pessoa ainda não aceitou.
model Friendship {
  userAId     String           @db.Uuid
  userBId     String           @db.Uuid
  requesterId String           @db.Uuid
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  acceptedAt  DateTime?

  userA User @relation("friendA", fields: [userAId], references: [id], onDelete: Cascade)
  userB User @relation("friendB", fields: [userBId], references: [id], onDelete: Cascade)

  @@id([userAId, userBId])
  @@index([userBId])
}

/// Registro das conversas (chat da sala e mensagens privadas) para a **administração** ler uma
/// conversa (ADR 0015, reverte o "conteúdo não é guardado" do ADR 0014). Não guarda nomes: só ids,
/// resolvidos na leitura (conta excluída aparece como "Conta excluída"). Sem FK para `User`: é um
/// registro de log, escrito pelo realtime, e some junto com a conta (ver `AccountService.delete`).
model MessageLog {
  /// Gerado pelo realtime (uuid), para casar com o evento entregue às sessões.
  id              String      @id @db.Uuid
  kind            MessageKind
  /// Sala (roomId efêmero do Colyseus) para ROOM; null para DIRECT.
  roomId          String?
  /// Título da sala no momento (ROOM); ajuda a administração a identificar.
  roomTitle       String?
  senderId        String      @db.Uuid
  /// Destinatário (DIRECT); null para ROOM.
  recipientId     String?     @db.Uuid
  /// Par ordenado para DIRECT (`menorId:maiorId`, ver `conversationKey`); null para ROOM.
  conversationKey String?
  text            String
  /// Horário do servidor (epoch ms do evento).
  sentAt          DateTime

  @@index([kind, sentAt])
  @@index([conversationKey, sentAt])
  @@index([roomId, sentAt])
  @@index([senderId, sentAt])
  @@index([recipientId, sentAt])
  /// Retenção de 90 dias: a API apaga o vencido pelas próprias leituras (sem tarefa agendada).
  @@index([sentAt])
}
