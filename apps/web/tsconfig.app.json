{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "lib": ["es2023", "dom"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "types": ["vite/client"],
    // Os pacotes compartilhados (packages/*) importam com extensão .ts (TypeScript nativo do Node).
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["src"]
}
