{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "lib": ["es2023", "dom"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "types": ["vite/client"],
    // Os pacotes compartilhados (packages/*) importam com extensão .ts (TypeScript nativo do Node).
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["src"],
  // Os testes importam `node:*` (leem os GLB de `public/`); eles têm o próprio programa, com os
  // tipos do Node (tsconfig.test.json), para o app seguir só com os tipos do navegador.
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
