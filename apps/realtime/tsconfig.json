{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "verbatimModuleSyntax": true,
    // Executado pelo TypeScript nativo do Node: só sintaxe apagável e imports com extensão .ts.
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "types": ["node"],
    "noEmit": true
  },
  "include": ["src", "scripts"]
}
