{
  "name": "@3dx/realtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --conditions=@3dx/source --watch --env-file-if-exists=../../.env src/main.ts",
    "start": "node --conditions=@3dx/source src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "load": "node --conditions=@3dx/source --env-file=../../.env scripts/load.ts"
  },
  "dependencies": {
    "@3dx/contracts": "workspace:*",
    "@3dx/game-core": "workspace:*",
    "@3dx/observability": "workspace:*",
    "@colyseus/core": "^0.18.18",
    "@colyseus/ws-transport": "^0.18.4",
    "jose": "^6.2.12",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@colyseus/sdk": "^0.18.5",
    "@types/node": "^24.19.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
