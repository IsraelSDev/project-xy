{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    // Pacotes do workspace: com esta condição, TypeScript (e Node/Vite configurados igual) usam o
    // fonte .ts; sem ela (produção), o JavaScript compilado em dist/.
    "customConditions": ["@3dx/source"],
    "types": []
  }
}
