{
  "name": "3dxchat-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "env:setup": "node scripts/setup-local-env.ts",
    "db:up": "docker compose --env-file .env -f infra/docker/compose.yaml up -d",
    "db:down": "docker compose --env-file .env -f infra/docker/compose.yaml down",
    "db:logs": "docker compose --env-file .env -f infra/docker/compose.yaml logs -f postgres",
    "db:backup": "node scripts/db-backup.ts",
    "db:restore-check": "node scripts/db-restore-check.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
